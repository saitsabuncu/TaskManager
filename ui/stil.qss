/*
 * TaskManager - Merkezi QSS Teması (Modern)
 *
 * Renk paleti:
 *   Vurgu (accent)           #4f46e5
 *   Vurgu - hover            #4338ca
 *   Vurgu - pressed          #3730a3
 *   Vurgu - açık zemin       #eef2ff
 *   Pencere arkaplanı        #eef0f6
 *   Yüzey (kart/liste/giriş) #ffffff
 *   Kenarlık                 #e7e9f0
 *   Metin                    #1e2433
 *   Metin - soluk            #8b93a7
 *   Grup başlığı             #a2a9ba
 *   Tehlike (silme)          #dc2626
 *   Tehlike - açık zemin     #fef2f2
 */

QWidget {
    background-color: #eef0f6;
    color: #1e2433;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QDialog {
    background-color: #eef0f6;
}

/* ---- Etiketler ---- */

QLabel {
    background-color: transparent;
}

#hosgeldinEtiketi {
    font-size: 13pt;
    font-weight: 700;
    color: #1e2433;
}

#bakiyeEtiketi {
    font-size: 11pt;
    font-weight: 600;
    color: #4f46e5;
}




/* ---- Butonlar ---- */

QPushButton {
    background-color: #ffffff;
    border: 1px solid #e7e9f0;
    border-radius: 8px;
    padding: 8px 14px;
    color: #1e2433;
}



QPushButton:pressed {
    border-color: #4f46e5;
}

QPushButton:disabled {
    background-color: #f1f5f9;
    color: #b7bdc9;
    border-color: #e7e9f0;
}


/* Birincil eylem: Görev Ekle */
QPushButton[role="primary"] {
    background-color: #4f46e5;
    border: none;
    color: #ffffff;
    font-weight: 600;
    padding: 9px 18px;
}



QPushButton[role="primary"]:pressed {
    background-color: #3730a3;
}





/* ---- Görev listesi ---- */

QListWidget {
    background-color: #ffffff;
    border: 1px solid #e7e9f0;
    border-radius: 14px;
    padding: 6px;
    outline: none;
}

QListWidget::item {
    padding: 10px 8px;
    border-radius: 8px;
    margin: 1px 0px;
}

QListWidget::item:hover {
    background-color: #f8fafc;
}

QListWidget::item:selected {
    background-color: #eef2ff;
    color: #1e2433;
}

QListWidget::item:selected:!active {
    background-color: #f1f5f9;
    color: #1e2433;
}

#gorevSatiri {
    background-color: transparent;
}

#seriEtiketi {
    color: #a2a9ba;
    font-size: 8pt;
    font-weight: 500;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1.5px solid #cbd1dc;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #4f46e5;
}

QCheckBox::indicator:checked {
    background-color: #4f46e5;
    border-color: #4f46e5;
}

/* ---- Açılır kutu (kategori filtresi) ---- */

QComboBox {
    background-color: #ffffff;
    border: 1px solid #e7e9f0;
    border-radius: 10px;
    padding: 7px 12px;
}

QComboBox:hover {
    border-color: #c7d2fe;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e7e9f0;
    selection-background-color: #4f46e5;
    selection-color: white;
    outline: none;
}

/* ---- Giriş alanları (QInputDialog içindeki QLineEdit vb.) ---- */

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #e7e9f0;
    border-radius: 8px;
    padding: 7px 10px;
    selection-background-color: #4f46e5;
}

QLineEdit:focus {
    border-color: #4f46e5;
}

/* ---- Menü butonları (Görev İşlemleri / Yönetim) ---- */

QToolButton {
    background-color: #ffffff;
    border: 1px solid #e7e9f0;
    border-radius: 10px;
    padding: 9px 16px;
    color: #1e2433;
    font-weight: 500;
}

QToolButton:hover {
    border-color: #c7d2fe;
    color: #4338ca;
}

QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e7e9f0;
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 18px;
    border-radius: 8px;
    color: #1e2433;
}

QMenu::item:selected {
    background-color: #eef2ff;
    color: #4338ca;
}